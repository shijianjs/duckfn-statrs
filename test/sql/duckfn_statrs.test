# name: test/sql/duckfn_statrs.test
# description: 冒烟测试：扩展能被加载，statrs 包装函数注册到位
# group: [duckfn_statrs]

# 加载之前这个名字不存在（每个 .test 文件都从一个干净的实例开始）
statement error
SELECT sr_mean(1.0);
----
Scalar Function with name sr_mean does not exist

# require 之后扩展就位（测试框架按 --external-extension 加载本地产物）
require duckfn_statrs

query I
SELECT sr_mean(x)::DECIMAL(10,1) FROM (VALUES (1.0), (2.0), (3.0)) t(x);
----
2.0

# statrs 全能力覆盖：34 个聚合 + 509 个标量 = 543（含 Modulus 的 5 个整数/浮点 overload），
# 与 statrs 模块树的对应关系见 functions/mod.rs 头注释。
# 改了函数数量记得同步这里（先跑 `just sql` 数一遍再填，别凭空加）。
query I
SELECT count(*) FROM duckdb_functions() WHERE starts_with(function_name, 'sr_');
----
543

query I
SELECT count(*) FROM duckdb_functions()
WHERE starts_with(function_name, 'sr_') AND function_type = 'aggregate';
----
34

query I
SELECT count(*) FROM duckdb_functions()
WHERE starts_with(function_name, 'sr_') AND function_type = 'scalar';
----
509
