# name: test/sql/aggregate_summary.test
# description: statrs::statistics 聚合包装。期望值取自 statrs 0.19.1 的官方用例
#   （statistics/slice_statistics.rs 与 statistics.rs 的 doc example、slice_statistics.rs::tests）；
#   statrs 覆盖不到的 SQL 侧情况（空组、NULL 跳过、GROUP BY、并行 combine）为本仓库新增用例。
# group: [duckfn_statrs]

require duckfn_statrs

# ============================================================================
# 官方 doc example：z = [0, 3, -2]（Statistics 各方法共用的断言数据）
# mean 1/3、variance 19/3、std_dev sqrt(19/3)、population_variance 38/9、population_std_dev sqrt(38/9)
# ============================================================================
query RRRRR
SELECT sr_mean(x)::DECIMAL(12,6),
       sr_variance(x)::DECIMAL(12,6),
       sr_std_dev(x)::DECIMAL(12,6),
       sr_population_variance(x)::DECIMAL(12,6),
       sr_population_std_dev(x)::DECIMAL(12,6)
FROM (VALUES (0.0), (3.0), (-2.0)) t(x);
----
0.333333	6.333333	2.516611	4.222222	2.054805

# ============================================================================
# 官方 doc example：geometric / harmonic mean（[1,2,3] 与「含 0 出 0」）、quadratic mean
# ============================================================================
query RR
SELECT sr_geometric_mean(x)::DECIMAL(12,6), sr_harmonic_mean(x)::DECIMAL(12,6)
FROM (VALUES (1.0), (2.0), (3.0)) t(x);
----
1.817121	1.636364

query RR
SELECT sr_geometric_mean(x)::DECIMAL(12,6), sr_harmonic_mean(x)::DECIMAL(12,6)
FROM (VALUES (0.0), (3.0), (2.0)) t(x);
----
0.000000	0.000000

# quadratic_mean 的 doc 值是 2.08167（epsilon 1e-5）；精确值 sqrt(13/3)
query R
SELECT sr_quadratic_mean(x)::DECIMAL(12,6) FROM (VALUES (0.0), (3.0), (-2.0)) t(x);
----
2.081666

# ============================================================================
# 官方用例：median
#   doc example y = [0, 3, -2] -> 0.0；test_order_statistic_short 的九个值 -> 1.0（第 5 小）
#   偶数个取中间两数平均是 statrs 的约定（本仓库补的用例）
# ============================================================================
query R
SELECT sr_median(x)::DECIMAL(12,6) FROM (VALUES (0.0), (3.0), (-2.0)) t(x);
----
0.000000

query R
SELECT sr_median(x)::DECIMAL(12,6)
FROM (VALUES (-1.0), (5.0), (0.0), (-3.0), (10.0), (-0.5), (4.0), (1.0), (6.0)) t(x);
----
1.000000

query R
SELECT sr_median(x)::DECIMAL(12,6) FROM (VALUES (1.0), (2.0), (3.0), (4.0)) t(x);
----
2.500000

# ============================================================================
# 官方用例：test_quantile_short，data = [-1, 5, 0, -3, 10, -0.5, 4, 0.2, 1, 6]（全部 10 项）
# statrs 断言自带 epsilon（1e-15 级），sqllogictest 的 R 列按浮点近似比较，
# 期望值直接写官方字面量（3/5=0.6、137/30、287/375、-37/240、-4/5=-0.8）。
# ============================================================================
query RRRRR
SELECT sr_quantile(x, 0.0), sr_quantile(x, 0.2), sr_quantile(x, 0.5),
       sr_quantile(x, 0.7), sr_quantile(x, 1.0)
FROM (VALUES (-1.0), (5.0), (0.0), (-3.0), (10.0), (-0.5), (4.0), (0.2), (1.0), (6.0)) t(x);
----
-3.0	-0.8	0.6	4.566666666666667	10.0

query RRRRR
SELECT sr_quantile(x, 0.01), sr_quantile(x, 0.2), sr_quantile(x, 0.325),
       sr_quantile(x, 0.52), sr_quantile(x, 0.99)
FROM (VALUES (-1.0), (5.0), (0.0), (-3.0), (10.0), (-0.5), (4.0), (0.2), (1.0), (6.0)) t(x);
----
-3.0	-0.8	-0.15416666666666667	0.7653333333333333	10.0

# 越界 tau：statrs 给 NAN（test_quantile_short 的范围守卫在 SQL 侧的对应），折成 NULL
query RR
SELECT sr_quantile(x, 1.5), sr_quantile(x, -0.1)
FROM (VALUES (1.0), (2.0)) t(x);
----
NULL	NULL

# ============================================================================
# 以下为本仓库新增用例（statrs 没有 SQL 形态的对应）
# ============================================================================

# 空组：test_empty_data_returns_nan 的 SQL 对应（mean/variance/population_variance 都 NAN → NULL）
query RRRR
SELECT sr_mean(x), sr_median(x), sr_variance(x), sr_population_variance(x)
FROM (VALUES (1.0)) t(x) WHERE 1 = 0;
----
NULL	NULL	NULL	NULL

# SQL NULL 行不进状态：(1, NULL, 3) 算的是 [1, 3]
query RRR
SELECT sr_mean(x)::DECIMAL(12,6), sr_variance(x)::DECIMAL(12,6), sr_std_dev(x)::DECIMAL(12,6)
FROM (VALUES (1.0), (NULL), (3.0)) t(x);
----
2.000000	2.000000	1.414214

# 单值没有样本方差/标准差（statrs NAN → NULL）
query RR
SELECT sr_variance(x), sr_std_dev(x) FROM (VALUES (1.0), (NULL)) t(x);
----
NULL	NULL

# 几何/调和平均的负数 = 无定义（doc: negative → NAN）→ NULL
query RR
SELECT sr_geometric_mean(x), sr_harmonic_mean(x)
FROM (VALUES (-1.0), (2.0)) t(x);
----
NULL	NULL

# GROUP BY：每个分组各自建状态
query RRR
SELECT g, sr_mean(x)::DECIMAL(12,6), sr_median(x)::DECIMAL(12,6)
FROM (VALUES (1, 1.0), (1, 3.0), (1, NULL), (2, 10.0)) t(g, x)
GROUP BY g ORDER BY g;
----
1	2.000000	2.000000
2	10.000000	10.000000

# 入参类型由 binder 拦下
statement error
SELECT sr_mean('a') FROM (VALUES ('x')) t(x);
----
Binder Error

# 并行聚合的 combine 与单线程一致
statement ok
PRAGMA threads=4;

query R
SELECT sr_mean(x::DOUBLE)::DECIMAL(12,6) FROM range(100000) t(x);
----
49999.500000

# 输入跨多个 DataChunk（STANDARD_VECTOR_SIZE = 2048），分区合并后结果不变
query R
SELECT sr_std_dev(x::DOUBLE)::DECIMAL(10,4) FROM range(3000) t(x);
----
866.1697
