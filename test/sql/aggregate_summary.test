# name: test/sql/aggregate_summary.test
# description: statrs::statistics 聚合包装：正常值、NULL 跳过、空组、GROUP BY、并行合并
# group: [duckfn_statrs]

require duckfn_statrs

# 期望值取自 statrs 的实际输出，统一以 DECIMAL(12,6) 定点打印
query RRRR
SELECT sr_mean(x)::DECIMAL(12,6),
       sr_geometric_mean(x)::DECIMAL(12,6),
       sr_harmonic_mean(x)::DECIMAL(12,6),
       sr_quadratic_mean(x)::DECIMAL(12,6)
FROM (VALUES (1.0), (2.0), (3.0)) t(x);
----
2.000000	1.817121	1.636364	2.160247

# 中位数：奇数个取中间，偶数个取中间两数的平均（statrs 的约定）
query RR
SELECT sr_median(x)::DECIMAL(12,6), sr_quantile(x, 0.5)::DECIMAL(12,6)
FROM (VALUES (3.0), (1.0), (2.0)) t(x);
----
2.000000	2.000000

query RR
SELECT sr_median(x)::DECIMAL(12,6), sr_quantile(x, 0.5)::DECIMAL(12,6)
FROM (VALUES (1.0), (2.0), (3.0), (4.0)) t(x);
----
2.500000	2.500000

# 样本版（Bessel 修正）与总体版的区别
query RRRR
SELECT sr_variance(x)::DECIMAL(12,6),
       sr_std_dev(x)::DECIMAL(12,6),
       sr_population_variance(x)::DECIMAL(12,6),
       sr_population_std_dev(x)::DECIMAL(12,6)
FROM (VALUES (0.0), (3.0), (-2.0)) t(x);
----
6.333333	2.516611	4.222222	2.054805

# SQL NULL 行不进状态（聚合惯例）：(1, NULL, 3) 算的是 [1, 3] 这一组
query RRR
SELECT sr_mean(x)::DECIMAL(12,6), sr_variance(x)::DECIMAL(12,6), sr_std_dev(x)::DECIMAL(12,6)
FROM (VALUES (1.0), (NULL), (3.0)) t(x);
----
2.000000	2.000000	1.414214

# 只剩一个有效值时没有样本方差/标准差：statrs 的 NAN 落成 NULL
query RR
SELECT sr_variance(x), sr_std_dev(x) FROM (VALUES (1.0), (NULL)) t(x);
----
NULL	NULL

# 空组（没有一行）在 statrs 里是 NAN，用户侧一律是 NULL 而不是 0
query RRRR
SELECT sr_mean(x), sr_median(x), sr_variance(x), sr_population_variance(x)
FROM (VALUES (1.0)) t(x) WHERE 1 = 0;
----
NULL	NULL	NULL	NULL

# tau 越界同样是 NAN → NULL（不是错误，与 DuckDB 自带的近似分位数一致）
query R
SELECT sr_quantile(x, 1.5) FROM (VALUES (1.0), (2.0)) t(x);
----
NULL

# 几何/调和平均遇到负数没有定义 → NULL
query RR
SELECT sr_geometric_mean(x), sr_harmonic_mean(x)
FROM (VALUES (-1.0), (2.0)) t(x);
----
NULL	NULL

# GROUP BY：每个分组各自建状态
query RRR
SELECT g, sr_mean(x)::DECIMAL(12,6), sr_median(x)::DECIMAL(12,6)
FROM (VALUES (1, 1.0), (1, 3.0), (1, NULL), (2, 10.0)) t(g, x)
GROUP BY g ORDER BY g;
----
1	2.000000	2.000000
2	10.000000	10.000000

# 入参类型由 binder 拦下：VARCHAR 升不成 DOUBLE
statement error
SELECT sr_mean('a') FROM (VALUES ('x')) t(x);
----
Binder Error

# 并行聚合把一组拆进多个分区再 combine：与单线程结果一致
statement ok
PRAGMA threads=4;

query R
SELECT sr_mean(x::DOUBLE)::DECIMAL(12,6) FROM range(100000) t(x);
----
49999.500000

# 输入跨多个 DataChunk（STANDARD_VECTOR_SIZE = 2048），状态负一正多分区后结果不变
query R
SELECT sr_std_dev(x::DOUBLE)::DECIMAL(10,4) FROM range(3000) t(x);
----
866.1697
