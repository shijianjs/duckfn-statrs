# name: test/sql/distribution/discrete.test
# description: 离散分布（bernoulli / binomial / discrete_uniform / geometric /
#   hypergeometric / negative_binomial / poisson）。锚点取解析精确值（binomial
#   pmf(3|0.5,10) = C(10,3)/2^10 = 0.1171875、geometric cdf(1|0.5) = 0.75 等）与
#   实跑输出；x 与整数参数的校验、概率越界为本仓库错误路径用例。
# group: [duckfn_statrs]

require duckfn_statrs

# Bernoulli：pmf(1)=p、cdf(0)=1-p、quantile 端 0/1
query RRRR
SELECT sr_bernoulli_pmf(1.0, 0.7), sr_bernoulli_pmf(0.0, 0.7),
       sr_bernoulli_cdf(0.0, 0.7), sr_bernoulli_quantile(0.5, 0.7)
----
0.7	0.3	0.30000000000000004	1.0

# Binomial：C(10,3)·0.5^10 = 120/1024（尾差由近似比较吸收）；对称点 cdf/quantile
query RR
SELECT sr_binomial_pmf(3.0, 0.5, 10.0)::DECIMAL(12,8), sr_binomial_quantile(0.5, 0.5, 10.0)
----
0.11718750	5.0

# Poisson：pmf(2|3) = e^-3·9/2；ln_pmf 与 pmf 互证
query RR
SELECT sr_poisson_pmf(2.0, 3.0)::DECIMAL(12,8), exp(sr_poisson_ln_pmf(2.0, 3.0))::DECIMAL(12,8)
----
0.22404181	0.22404181

# Geometric（statrs 定义：首次成功所需的试验数，支撑从 1 起）：cdf(1|0.5) = p = 0.5
query RR
SELECT sr_geometric_cdf(1.0, 0.5), sr_geometric_sf(1.0, 0.5)::DECIMAL(12,8)
----
0.5	0.50000000

# Hypergeometric：pmf(2 | N=10, K=5, n=4) = C(5,2)C(5,2)/C(10,4) = 100/210
query R
SELECT sr_hypergeometric_pmf(2.0, 10.0, 5.0, 4.0)::DECIMAL(12,8)
----
0.47619048

# NegativeBinomial：pmf(3|2,0.5) = C(4,1)·0.5^4 = 0.125
query R
SELECT sr_negative_binomial_pmf(3.0, 2.0, 0.5)::DECIMAL(12,8)
----
0.12500000

# DiscreteUniform：pmf = 1/6、quantile(0.5) 取到第 3 个点
query RR
SELECT sr_discrete_uniform_pmf(2.0, 1.0, 6.0)::DECIMAL(12,8), sr_discrete_uniform_quantile(0.5, 1.0, 6.0)
----
0.16666667	3.0

# x 非整数报错（不四舍五入）；负数同样
statement error
SELECT sr_binomial_pmf(2.5, 0.5, 10.0)
----
expected a non-negative whole number, got 2.5

# 概率参数越界
statement error
SELECT sr_poisson_quantile(-0.1, 3.0)
----
the probability must be within [0, 1], got -0.1

# 非法分布参数（二项 p 越出 [0,1]）
statement error
SELECT sr_binomial_pmf(1.0, 1.5, 10.0)
----
sr_binomial_pmf

# NULL 输入短路成 NULL
query R
SELECT sr_poisson_pmf(NULL, 3.0)
----
NULL
