# name: test/sql/function.test
# description: statrs::function 特殊函数包装。期望值来自 statrs 0.19.1 function/ 各文件
#   的 doc example / 内部测试常量（gamma(5)=24、choose(10,3)=120、logistic(0)=0.5 等），
#   定点值以实跑输出为准（DECIMAL 截断展示）；整数校验与错误路径为本仓库用例。
# group: [duckfn_statrs]

require duckfn_statrs

# erf 族：erf(1)=0.842701、erfc 互补、erf_inv 往返（statrs doc：erf(0)=0）
query RRRR
SELECT sr_erf(0.0), sr_erf(1.0)::DECIMAL(12,6), sr_erfc(1.0)::DECIMAL(12,6),
       sr_erf_inv(sr_erf(0.7))::DECIMAL(12,8);
----
0.0	0.842701	0.157299	0.70000000

# gamma 族（doc：Γ(5)=4!=24；ln Γ(5)=ln 24；ψ(2)=1-γ_E=0.42278434）
query RRR
SELECT sr_gamma(5.0), sr_ln_gamma(5.0)::DECIMAL(12,6), sr_digamma(2.0)::DECIMAL(12,8);
----
24.0	3.178054	0.42278434

# 不完全/正则化 gamma（doc：P(1,1) = 1 - e^-1 = 0.63212056；上/下正则化互补）
query RRR
SELECT sr_gamma_lower_regularized(1.0, 1.0)::DECIMAL(12,8),
       sr_gamma_upper_regularized(1.0, 1.0)::DECIMAL(12,8),
       (sr_gamma_lower_regularized(2.0, 1.0) + sr_gamma_upper_regularized(2.0, 1.0))::DECIMAL(12,8);
----
0.63212056	0.36787944	1.00000000

query RR
SELECT sr_gamma_lower_incomplete(1.0, 1.0)::DECIMAL(12,8), sr_gamma_upper_incomplete(1.0, 1.0)::DECIMAL(12,8);
----
0.63212056	0.36787944

# beta 族（B(2,3)=1/12；正则化不完全 Beta 即 Beta 分布 CDF，与 distribution 层互证；
# SQL 侧参数顺序与 statrs 一致：(a, b, x)）
query RRR
SELECT sr_beta(2.0, 3.0)::DECIMAL(12,8), sr_ln_beta(2.0, 3.0)::DECIMAL(12,8),
       sr_beta_regularized(2.0, 3.0, 0.5)::DECIMAL(12,8);
----
0.08333333	-2.48490665	0.68750000

# inv_beta_regularized 是 beta_regularized 的反函数（给定概率求 x）；往返自证。
# 已知上游问题：statrs 0.19.1 的 Newton 迭代对个别输入（如 (2,3,0.6875)）会 unwrap panic，
# duckfn 把 panic 接成查询错误、不会破 FFI —— 不为其写断言，避开的输入已记录。
query RR
SELECT sr_inv_beta_regularized(2.0, 3.0, 0.5)::DECIMAL(12,8),
       sr_beta_regularized(2.0, 3.0, sr_inv_beta_regularized(2.0, 3.0, 0.5))::DECIMAL(12,8)
----
0.38572757	0.50000000

# 阶乘与二项系数（doc：10! = 3628800、choose(10,3) = 120；ln 往返）
query RRRR
SELECT sr_factorial(10.0), sr_choose(10.0, 3.0),
       sr_ln_factorial(10.0)::DECIMAL(12,8),
       exp(sr_ln_choose(10.0, 3.0))::DECIMAL(12,8);
----
3628800.0	120.0	15.10441257	120.00000000

# 调和数（H(10)=7381/2520=2.92896825；广义 H(10,2)=1.54976773）
query RR
SELECT sr_harmonic(10.0)::DECIMAL(12,8), sr_generalized_harmonic(10.0, 2.0)::DECIMAL(12,8);
----
2.92896825	1.54976773

# logistic / logit 互逆；端点给无穷、区间外给 NULL（statrs checked_logit 的 None）
query RRRR
SELECT sr_logistic(0.0), sr_logit(sr_logistic(1.3))::DECIMAL(12,8),
       sr_logit(0.0), sr_logit(1.2);
----
0.5	1.30000000	-inf	NULL

# 指数积分 E_n（E_1(0) 发散为 inf，doc 定义域内 n>=1 的取值以实跑为准）
query RR
SELECT sr_exponential_integral(0.0, 1.0), sr_exponential_integral(1.0, 1.0)::DECIMAL(12,8);
----
inf	0.21938393

# 写错的整数报错，不四舍五入
statement error
SELECT sr_factorial(3.5);
----
expected a non-negative whole number, got 3.5

statement error
SELECT sr_choose(10.0, 2.5);
----
expected a non-negative whole number, got 2.5

# ============================================================================
# doc example 全覆盖：本组其余函数各一条用例。SQL 取自函数源码的 `example`
# 属性（即 statrs 官方文档示例），期望值由已构建扩展实跑捕获。
# ============================================================================

# Inverse complementary error function, erfc(x) = y solved for x
query R
SELECT sr_erfc_inv(0.15729920705028513)
----
1.0

# Inverse digamma function, ψ(x) = y solved for x
query R
SELECT sr_inv_digamma(0.42278433509846713)
----
2.0000000000000018

# Multinomial coefficient n! / (n1! n2! ...) over a whole-number n and a count LIST(BIGINT); NULL when the counts do not sum to n
query R
SELECT sr_multinomial_coefficient(5.0, [2, 2, 1])
----
30.0
